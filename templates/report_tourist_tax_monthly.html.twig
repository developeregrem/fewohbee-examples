<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial, sans-serif; font-size: 12px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
        th, td { border: 1px solid #000; padding: 6px; vertical-align: top; }
        th { background: #e8eef2; text-align: left; }
        .text-right { text-align: right; }
        .muted { color: #666; font-size: 11px; }
        .section-title { background: #2e6c80; color: #fff; padding: 6px 8px; margin-top: 14px; font-weight: bold; }
        .totals-row { background: #f0f4f7; font-weight: bold; }
        .empty-cell { color: #999; }
    </style>
</head>
<body>
    <div class="header">
        <div class="muted" style="text-align: center;">
            [[ simple.meta.subsidiaryName ?: (simple.meta.subsidiaryAllLabelKey|trans({}, 'Housekeeping')) ]] |
            [[ simple.meta.periodLabel ]] |
            Erzeugt [[ simple.meta.generatedAt ]]
        </div>
    </div>
    <div class="footer">
        <div class="muted" style="text-align: right; font-size: 10px;">Seite {PAGENO} von {nbpg}</div>
    </div>

    <h2>Abrechnung Beherbergungsabgaben — [[ filters.start|date('m.Y') ]]</h2>

    [% set selectedYear = filters.start|date('Y') %]
    [% set selectedMonth = filters.start|date('n') %]
    [% set currentTaxMonth = touristTax.months|filter(m => m.year == selectedYear and m.month == selectedMonth)|first %]
    [% set currentTaxes = currentTaxMonth ? currentTaxMonth.taxes : [] %]

    <div data-repeat="currentTaxes" data-repeat-as="tax">
        <div class="section-title">[[ tax.name ]]</div>
        <table>
            <thead>
                <tr>
                    <th style="width: 20%;">Anzahl Übernachtungen</th>
                    <th>Gäste</th>
                    <th class="text-right" style="width: 18%;">Preis pro Nacht</th>
                    <th class="text-right" style="width: 18%;">Summe</th>
                </tr>
            </thead>
            <tbody>
                <tr data-repeat="tax.groups" data-repeat-as="group">
                    <td>[[ group.totalNights ]]</td>
                    <td>
                        [[ group.label ]]
                        <span data-if="not group.pricePerNightConsistent" class="muted">(uneinheitliche Preise — bitte Konfiguration prüfen)</span>
                    </td>
                    <td class="text-right">[[ group.pricePerNight|number_format(2, ',', '.') ]]</td>
                    <td class="text-right">[[ group.totalAmount|number_format(2, ',', '.') ]]</td>
                </tr>
                <tr data-if="tax.groups is empty">
                    <td colspan="4" class="muted">Keine Buchungen mit Preis in diesem Zeitraum.</td>
                </tr>
                <tr data-if="tax.groups is not empty" class="totals-row">
                    <td>[[ tax.totalNights ]]</td>
                    <td colspan="2">Summe</td>
                    <td class="text-right">[[ tax.totalAmount|number_format(2, ',', '.') ]]</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div data-if="currentTaxes is empty" class="muted">Keine gültigen Beherbergungsabgaben für den gewählten Monat konfiguriert.</div>

    [% set currentStatisticsMonth = statistics.months|filter(m => m.year == selectedYear and m.month == selectedMonth)|first %]
    [% set currentMetrics = currentStatisticsMonth ? currentStatisticsMonth.metrics : null %]
    [% set countryAndCategory = currentMetrics.tourism.overnights_by_country_and_category ?? {} %]
    [% set columnTotals = {} %]
    [% set grandTotal = 0 %]

    <div class="section-title">Übernachtungen nach Ländern</div>
    <table>
        <thead>
            <tr>
                <th>Land</th>
                <th data-repeat="touristTax.guestCategories" data-repeat-as="category" class="text-right">[[ category.name ]]</th>
                <th class="text-right">Gesamt</th>
            </tr>
        </thead>
        <tbody>
            <tr data-repeat="countryAndCategory" data-repeat-key="countryCode" data-repeat-as="rowData">
                [% set rowTotal = 0 %]
                <td>[[ statistics.countryNames[countryCode|upper] ?? countryCode ]]</td>
                <td data-repeat="touristTax.guestCategories" data-repeat-as="category" class="text-right">
                    [% set categoryTotalKey = 'category_' ~ category.id %]
                    [% set v = rowData[category.id] ?? 0 %]
                    [% set rowTotal = rowTotal + v %]
                    [% set columnTotals = columnTotals|merge({ (categoryTotalKey): (columnTotals[categoryTotalKey] ?? 0) + v }) %]
                    [[ v|round(0) ]]
                </td>
                [% set grandTotal = grandTotal + rowTotal %]
                <td class="text-right">[[ rowTotal|round(0) ]]</td>
            </tr>
            <tr data-if="countryAndCategory is empty">
                <td colspan="99" class="muted">Keine Übernachtungen nach Ländern in diesem Zeitraum vorhanden.</td>
            </tr>
            <tr class="totals-row">
                <td>Gesamt</td>
                <td data-repeat="touristTax.guestCategories" data-repeat-as="category" class="text-right">[[ (columnTotals['category_' ~ category.id] ?? 0)|round(0) ]]</td>
                <td class="text-right">[[ grandTotal|round(0) ]]</td>
            </tr>
        </tbody>
    </table>

    <div class="muted" style="margin-top: 14px;">
        * Befreiungen richten sich nach den jeweils geltenden lokalen Bestimmungen. Der vorliegende Bericht
        wird vollständig aus den in der PMS-Software gepflegten Gastkategorien und Preisen erzeugt; wenn die
        Konfiguration angepasst wird, ändern sich die Zahlen im nächsten Berichtsdruck automatisch.
    </div>
</body>
</html>
